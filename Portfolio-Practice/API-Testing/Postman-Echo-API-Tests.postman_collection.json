{
  "info": {
    "name": "API Testing Practice - Postman Echo",
    "description": "Independent API testing practice using Postman Echo. Not an employer API or work artifact.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET - Query Parameters",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://postman-echo.com/get?memberStatus=active&planType=sample",
          "protocol": "https",
          "host": [
            "postman-echo",
            "com"
          ],
          "path": [
            "get"
          ],
          "query": [
            {
              "key": "memberStatus",
              "value": "active"
            },
            {
              "key": "planType",
              "value": "sample"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response returns submitted query parameters', function () {",
              " const data = pm.response.json();",
              " pm.expect(data.args.memberStatus).to.eql('active');",
              " pm.expect(data.args.planType).to.eql('sample');",
              "});",
              "pm.test('Response time is under 5 seconds', function () { pm.expect(pm.response.responseTime).to.be.below(5000); });"
            ]
          }
        }
      ]
    },
    {
      "name": "POST - JSON Request Body",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"testRecord\": \"DEMO-001\",\n  \"workflow\": \"eligibility-check\",\n  \"expectedStatus\": \"active\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://postman-echo.com/post",
          "protocol": "https",
          "host": [
            "postman-echo",
            "com"
          ],
          "path": [
            "post"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response echoes the JSON body', function () {",
              " const data = pm.response.json();",
              " pm.expect(data.json.testRecord).to.eql('DEMO-001');",
              " pm.expect(data.json.workflow).to.eql('eligibility-check');",
              "});",
              "pm.test('Response content type is JSON', function () { pm.response.to.have.header('Content-Type', /application\\\\/json/); });"
            ]
          }
        }
      ]
    },
    {
      "name": "GET - Header Echo",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-QA-Test",
            "value": "portfolio-practice"
          }
        ],
        "url": {
          "raw": "https://postman-echo.com/headers",
          "protocol": "https",
          "host": [
            "postman-echo",
            "com"
          ],
          "path": [
            "headers"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Custom test header is returned', function () {",
              " const data = pm.response.json();",
              " pm.expect(data.headers['x-qa-test']).to.eql('portfolio-practice');",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://postman-echo.com"
    }
  ]
}